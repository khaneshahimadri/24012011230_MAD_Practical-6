<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FC">

    <!-- App Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAD_Animation_Practical"
        android:textSize="22sp"
        android:textColor="#29252B"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mainCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Alarm Image -->
            <ImageView
                android:id="@+id/alarmImage"
                android:layout_width="0dp"
                android:layout_height="265dp"
                android:src="@drawable/alarm1"
                android:scaleType="centerCrop"
                android:background="#050505"
                android:contentDescription="Alarm Clock"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Heading -->
            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Alarm Time"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#39343B"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/alarmImage"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="By pressing buttons, Alarm can be created and cancelled."
                android:textSize="14sp"
                android:textColor="#57525A"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeading"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Current Time Text -->
            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Check Current time by looking below real digital clock."
                android:textSize="14sp"
                android:textColor="#57525A"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Heart -->
            <TextView
                android:id="@+id/tvHeart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textSize="25sp"
                android:textColor="#55505A"
                android:layout_marginEnd="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvCurrentTime"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Create Alarm Button -->
            <Button
                android:id="@+id/btnCreateAlarm"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="⏱  Create Alarm"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:backgroundTint="#7EA7FF"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCancelAlarm"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Cancel Alarm Button -->
            <Button
                android:id="@+id/btnCancelAlarm"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="⏱  Cancel Alarm"
                android:textAllCaps="false"
                android:textColor="#79A1F5"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeart"
                app:layout_constraintStart_toEndOf="@id/btnCreateAlarm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>